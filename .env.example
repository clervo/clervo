# Copy to .env for local development only. Never commit populated environment files.
CLERVO_ENV=development
CLERVO_SERVICE_NAME=clervo-api
CLERVO_LOG_LEVEL=debug
CLERVO_HTTP_HOST=127.0.0.1
CLERVO_HTTP_PORT=3000
CLERVO_RELEASE_ID=local-development

# Secret-bearing variables are names only. Obtain values from the environment's
# approved secret store; do not place real credentials in this example file.
DATABASE_URL=
QUEUE_DATABASE_URL=