{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "clervo-api-edge-production",
  "main": "./src/api-edge.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CLERVO_AI_PUBLIC_ENABLED": "true"
  },
  "secrets": {
    "required": ["CLERVO_EDGE_AUTHORIZATION"]
  },
  "routes": [
    {
      "pattern": "api.clervo.dev/",
      "zone_name": "clervo.dev"
    },
    {
      "pattern": "api.clervo.dev/*",
      "zone_name": "clervo.dev"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
