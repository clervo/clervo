{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "clervo-site-production",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "clervo.dev/*",
      "zone_name": "clervo.dev"
    },
    {
      "pattern": "www.clervo.dev/*",
      "zone_name": "clervo.dev"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
