{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "clervo-site-production",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "clervo.dev/*",
      "zone_name": "clervo.dev"
    },
    {
      "pattern": "www.clervo.dev/*",
      "zone_name": "clervo.dev"
    }
  ],
  "assets": {
    "directory": "./dist",
    // Every real route is prerendered to its own index.html, so an unmatched
    // path is genuinely not a page. `single-page-application` answered 200 to
    // every URL, which is why a crawler would not index the site: a site that
    // says yes to everything says nothing. `404-page` serves the prerendered
    // /404.html with a real 404 status.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
