          "amountAtomic": "2500",
          "decimals": 6
        },
        "maximumChargeRequired": true,
        "priceVersion": "search-answer-mock-1"
      },
      "freeEndpoint": "https://api.clervo.dev/v1/search/free",
      "paidEndpoint": "https://api.clervo.dev/v1/search/paid",
