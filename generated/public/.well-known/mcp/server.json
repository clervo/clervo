{
  "schemaVersion": "clervo.mcp-discovery.v1",
  "name": "@clervo/mcp",
  "version": "0.5.2",
  "registryUrl": "https://www.npmjs.com/package/@clervo/mcp",
  "transport": "stdio",
  "publicApiAvailable": true,
  "publicApiBaseUrl": "https://api.clervo.dev",
  "configurationRequired": [],
  "configurationOptional": [
    "CLERVO_BASE_URL",
    "CLERVO_HOME",
    "CLERVO_AUTO_PAY"
  ],
  "paymentSigningImplemented": true,
  "automaticPaymentRetry": false,
  "installCommand": "npx -y @clervo/mcp@0.5.2",
  "claudeCodeCommand": "claude mcp add clervo -s user -- npx -y @clervo/mcp",
  "documentationUrl": "https://clervo.dev/start/"
}
