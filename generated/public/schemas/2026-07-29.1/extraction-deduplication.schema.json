{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/extraction-deduplication.schema.json",
  "title": "Clervo deterministic extraction and content deduplication",
  "$defs": {
    "segment": {
      "type": "object",
      "required": [
        "kind",
        "text",
        "startOffset",
        "endOffset"
      ],
      "properties": {
        "kind": {
          "enum": [
            "heading",
            "paragraph",
            "list_item"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500000
        },
        "startOffset": {
          "type": "integer",
          "minimum": 0
        },
        "endOffset": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "extraction": {
      "type": "object",
      "required": [
        "contractVersion",
        "extractionId",
        "fetchId",
        "finalUrl",
        "contentType",
        "sourceBodySha256",
        "normalizedTextSha256",
        "normalizedText",
        "segments",
        "warnings",
        "isolation",
        "instructionHandling"
      ],
      "properties": {
        "contractVersion": {
          "const": "2026-07-29.1"
        },
        "extractionId": {
          "type": "string",
          "pattern": "^extract_[A-Za-z0-9]{20,64}$"
        },
        "fetchId": {
          "type": "string",
          "pattern": "^fetch_[A-Za-z0-9]{20,64}$"
        },
        "finalUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "contentType": {
          "enum": [
            "text/html",
            "text/plain",
            "application/xhtml+xml"
          ]
        },
        "sourceBodySha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "normalizedTextSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "normalizedText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500000
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "active_content_removed",
              "instruction_like_text_present"
            ]
          }
        },
        "isolation": {
          "const": "worker_thread"
        },
        "instructionHandling": {
          "const": "untrusted_data_only"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "extraction",
        "disposition",
        "similarityBasisPoints"
      ],
      "properties": {
        "extraction": {
          "$ref": "#/$defs/extraction"
        },
        "disposition": {
          "enum": [
            "retained",
            "exact_duplicate",
            "near_duplicate"
          ]
        },
        "duplicateOfExtractionId": {
          "type": "string",
          "pattern": "^extract_[A-Za-z0-9]{20,64}$"
        },
        "similarityBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "retained"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "duplicateOfExtractionId": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "exact_duplicate",
                  "near_duplicate"
                ]
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "duplicateOfExtractionId"
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "contractVersion",
    "batchId",
    "shingleSize",
    "nearDuplicateThresholdBasisPoints",
    "inputCount",
    "retainedCount",
    "exactDuplicateCount",
    "nearDuplicateCount",
    "results"
  ],
  "properties": {
    "contractVersion": {
      "const": "2026-07-29.1"
    },
    "batchId": {
      "type": "string",
      "pattern": "^batch_[A-Za-z0-9]{20,64}$"
    },
    "shingleSize": {
      "const": 5
    },
    "nearDuplicateThresholdBasisPoints": {
      "type": "integer",
      "minimum": 5000,
      "maximum": 10000
    },
    "inputCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "retainedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "exactDuplicateCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "nearDuplicateCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "results": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "additionalProperties": false
}
