{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/search-benchmark.schema.json",
  "title": "Clervo recorded offline search benchmark report",
  "$defs": {
    "metrics": {
      "type": "object",
      "required": [
        "recallBasisPoints",
        "freshnessBasisPoints",
        "citationValidityBasisPoints",
        "duplicateBasisPoints",
        "p95LatencyMs",
        "averageCostMicrousd",
        "injectionPassBasisPoints",
        "providerFailurePassBasisPoints",
        "qualityScoreBasisPoints"
      ],
      "properties": {
        "recallBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "freshnessBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "citationValidityBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "duplicateBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "p95LatencyMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000
        },
        "averageCostMicrousd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "injectionPassBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "providerFailurePassBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "qualityScoreBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "caseId",
        "category",
        "candidate",
        "baseline"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "pattern": "^bcase_[A-Za-z0-9]{20,64}$"
        },
        "category": {
          "enum": [
            "relevance",
            "freshness",
            "citation",
            "duplicate",
            "adversarial_injection",
            "provider_failure"
          ]
        },
        "candidate": {
          "$ref": "#/$defs/metrics"
        },
        "baseline": {
          "$ref": "#/$defs/metrics"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "contractVersion",
    "benchmarkId",
    "corpusId",
    "corpusVersion",
    "corpusSha256",
    "baselineId",
    "evaluatedAt",
    "policyId",
    "caseCount",
    "candidate",
    "baseline",
    "baselineImprovementBasisPoints",
    "outcome",
    "failureCodes",
    "cases",
    "scope"
  ],
  "properties": {
    "contractVersion": {
      "const": "2026-07-29.1"
    },
    "benchmarkId": {
      "type": "string",
      "pattern": "^bench_[A-Za-z0-9]{20,64}$"
    },
    "corpusId": {
      "type": "string",
      "pattern": "^corpus_[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "corpusVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "corpusSha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "baselineId": {
      "type": "string",
      "pattern": "^baseline_[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "policyId": {
      "const": "search_recorded_quality_v1"
    },
    "caseCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "candidate": {
      "$ref": "#/$defs/metrics"
    },
    "baseline": {
      "$ref": "#/$defs/metrics"
    },
    "baselineImprovementBasisPoints": {
      "type": "integer",
      "minimum": -10000,
      "maximum": 10000
    },
    "outcome": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "failureCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "recall_below_threshold",
          "freshness_below_threshold",
          "citation_validity_below_threshold",
          "duplicates_above_threshold",
          "latency_above_threshold",
          "cost_above_threshold",
          "injection_boundary_failed",
          "provider_failure_behavior_failed",
          "baseline_improvement_below_threshold"
        ]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "scope": {
      "const": "recorded_offline_corpus"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "passed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "failureCodes": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "failureCodes": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
