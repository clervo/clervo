{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.clervo.dev/2026-07-29.1/retrieval-cache-disclosure.schema.json",
  "title": "Clervo route-bound durable retrieval cache disclosure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "reason",
    "cacheKey",
    "routeId",
    "normalizedUrl",
    "requestPolicySha256",
    "observedAt",
    "staleWhileDegraded"
  ],
  "properties": {
    "state": {
      "enum": [
        "miss",
        "fresh",
        "stale_while_degraded"
      ]
    },
    "reason": {
      "enum": [
        "not_found",
        "forced_refresh",
        "fresh_hit",
        "stale_disclosed",
        "expired",
        "poisoned",
        "denylisted"
      ]
    },
    "cacheKey": {
      "$ref": "#/$defs/hash"
    },
    "routeId": {
      "enum": [
        "clervo.focused-index.v1",
        "clervo.live-federation.v1"
      ]
    },
    "normalizedUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "requestPolicySha256": {
      "$ref": "#/$defs/hash"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "fetchedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "ageSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "staleWhileDegraded": {
      "type": "boolean"
    },
    "bodySha256": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "fresh",
              "stale_while_degraded"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "fetchedAt",
          "expiresAt",
          "ageSeconds",
          "bodySha256"
        ],
        "properties": {
          "fetchedAt": true,
          "expiresAt": true,
          "ageSeconds": true,
          "bodySha256": true
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "stale_while_degraded"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "const": "stale_disclosed"
          },
          "staleWhileDegraded": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "miss",
              "fresh"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "staleWhileDegraded": {
            "const": false
          }
        }
      }
    }
  ]
}
