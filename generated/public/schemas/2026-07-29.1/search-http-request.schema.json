{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/search-http-request.schema.json",
  "title": "Clervo bounded search HTTP request",
  "type": "object",
  "required": [
    "query"
  ],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "maxResults": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 10
    },
    "synthesize": {
      "type": "boolean",
      "default": true
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "default": "en"
    },
    "region": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "default": "US"
    }
  },
  "additionalProperties": false
}
