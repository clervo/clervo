{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.clervo.dev/2026-07-29.1/connected-retrieval-response.schema.json",
  "title": "Clervo connected retrieval response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "schemaVersion",
    "operationId",
    "productId",
    "query",
    "rewriteQueries",
    "language",
    "region",
    "generatedAt",
    "status",
    "degradedRoutes",
    "attempts",
    "exactDuplicateCount",
    "nearDuplicateCount",
    "results",
    "citations"
  ],
  "properties": {
    "contractVersion": {
      "const": "2026-07-29.1"
    },
    "schemaVersion": {
      "const": "clervo.connected-retrieval.response.v1"
    },
    "operationId": {
      "type": "string",
      "pattern": "^op_[A-Za-z0-9]{20,64}$"
    },
    "productId": {
      "const": "search.web"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "rewriteQueries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "items": false
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})?$"
    },
    "region": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ready",
        "degraded"
      ]
    },
    "degradedRoutes": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/routeId"
      }
    },
    "attempts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "exactDuplicateCount": {
      "type": "integer",
      "minimum": 0
    },
    "nearDuplicateCount": {
      "type": "integer",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "citations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/citation"
      }
    }
  },
  "$defs": {
    "routeId": {
      "enum": [
        "clervo.focused-index.v1",
        "clervo.live-federation.v1"
      ]
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeId",
        "providerId",
        "healthIdentity",
        "circuitIdentity",
        "failureDomain",
        "startedAt",
        "completedAt",
        "outcome",
        "resultCount"
      ],
      "properties": {
        "routeId": {
          "$ref": "#/$defs/routeId"
        },
        "providerId": {
          "type": "string",
          "pattern": "^provider_[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "healthIdentity": {
          "type": "string",
          "pattern": "^clervo\\.health\\."
        },
        "circuitIdentity": {
          "type": "string",
          "pattern": "^clervo\\.circuit\\."
        },
        "failureDomain": {
          "type": "string",
          "pattern": "^clervo\\."
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "deadline_exceeded",
            "cancelled"
          ]
        },
        "resultCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "failureCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceName",
        "sourceUrl",
        "license",
        "notice"
      ],
      "properties": {
        "sourceId": {
          "enum": [
            "focused_index",
            "wikimedia",
            "crossref",
            "common_crawl"
          ]
        },
        "sourceName": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "notice": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fetchId",
        "extractionId",
        "sourceBodySha256",
        "normalizedTextSha256",
        "instructionHandling",
        "renderMode",
        "crawl4aiStatus"
      ],
      "properties": {
        "fetchId": {
          "type": "string",
          "pattern": "^fetch_[A-Za-z0-9]{20,64}$"
        },
        "extractionId": {
          "type": "string",
          "pattern": "^extract_[A-Za-z0-9]{20,64}$"
        },
        "sourceBodySha256": {
          "$ref": "#/$defs/hash"
        },
        "normalizedTextSha256": {
          "$ref": "#/$defs/hash"
        },
        "instructionHandling": {
          "const": "untrusted_data_only"
        },
        "renderMode": {
          "enum": [
            "static",
            "crawl4ai_javascript"
          ]
        },
        "crawl4aiStatus": {
          "enum": [
            "not_used",
            "provisional_n4_25",
            "runtime_attested"
          ]
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshness",
        "authority",
        "relevance",
        "diversity",
        "totalBasisPoints"
      ],
      "properties": {
        "freshness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "authority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "relevance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "diversity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "totalBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeId",
        "providerId",
        "adapterId",
        "url",
        "title",
        "evidenceText",
        "retrievedAt",
        "authorityScore",
        "relevanceScore",
        "language",
        "region",
        "attribution",
        "extraction",
        "canonicalUrl",
        "resultId",
        "hostname",
        "rank",
        "score"
      ],
      "properties": {
        "routeId": {
          "$ref": "#/$defs/routeId"
        },
        "providerId": {
          "type": "string",
          "pattern": "^provider_[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "adapterId": {
          "type": "string",
          "pattern": "^adapter_[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "evidenceText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "authorityScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "relevanceScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})?$"
        },
        "region": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "attribution": {
          "$ref": "#/$defs/attribution"
        },
        "extraction": {
          "$ref": "#/$defs/extraction"
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "resultId": {
          "type": "string",
          "pattern": "^csr_[a-f0-9]{40}$"
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "score": {
          "$ref": "#/$defs/score"
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citationId",
        "resultId",
        "routeId",
        "canonicalUrl",
        "quote",
        "startOffset",
        "endOffset",
        "extractionId"
      ],
      "properties": {
        "citationId": {
          "type": "string",
          "pattern": "^ccite_[a-f0-9]{36}$"
        },
        "resultId": {
          "type": "string",
          "pattern": "^csr_[a-f0-9]{40}$"
        },
        "routeId": {
          "$ref": "#/$defs/routeId"
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "startOffset": {
          "type": "integer",
          "minimum": 0
        },
        "endOffset": {
          "type": "integer",
          "minimum": 1
        },
        "extractionId": {
          "type": "string",
          "pattern": "^extract_[A-Za-z0-9]{20,64}$"
        }
      }
    }
  }
}
