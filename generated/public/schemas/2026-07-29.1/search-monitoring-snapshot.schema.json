{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/search-monitoring-snapshot.schema.json",
  "title": "Clervo bounded search monitoring snapshot",
  "$defs": {
    "latency": {
      "type": "object",
      "required": [
        "count",
        "total",
        "maximum",
        "average"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        },
        "maximum": {
          "type": "number",
          "minimum": 0
        },
        "average": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "service",
    "summary",
    "metricPoints",
    "alerts",
    "exportState"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "service": {
      "const": "search.api"
    },
    "summary": {
      "type": "object",
      "required": [
        "requestsObserved",
        "successfulExecutions",
        "failedExecutions",
        "quotaRejections",
        "paymentChallenges",
        "paidCompletions",
        "availabilityRatio",
        "latencySeconds"
      ],
      "properties": {
        "requestsObserved": {
          "type": "integer",
          "minimum": 0
        },
        "successfulExecutions": {
          "type": "integer",
          "minimum": 0
        },
        "failedExecutions": {
          "type": "integer",
          "minimum": 0
        },
        "quotaRejections": {
          "type": "integer",
          "minimum": 0
        },
        "paymentChallenges": {
          "type": "integer",
          "minimum": 0
        },
        "paidCompletions": {
          "type": "integer",
          "minimum": 0
        },
        "availabilityRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "latencySeconds": {
          "$ref": "#/$defs/latency"
        }
      },
      "additionalProperties": false
    },
    "metricPoints": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "metric-point.schema.json"
      }
    },
    "alerts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "alert-event.schema.json"
      }
    },
    "exportState": {
      "type": "object",
      "required": [
        "configured",
        "successfulExports",
        "failedExports"
      ],
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "successfulExports": {
          "type": "integer",
          "minimum": 0
        },
        "failedExports": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
