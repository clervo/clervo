{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.clervo.dev/2026-07-29.1/crawl4ai-worker-health.schema.json",
  "title": "Clervo internal Crawl4AI worker health",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lifecycle",
    "isolationProven",
    "killSwitchEngaged",
    "activeJobs",
    "orphanCount",
    "reason"
  ],
  "properties": {
    "lifecycle": {
      "enum": [
        "ready",
        "degraded",
        "unavailable"
      ]
    },
    "isolationProven": {
      "type": "boolean"
    },
    "killSwitchEngaged": {
      "type": "boolean"
    },
    "activeJobs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "orphanCount": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "enum": [
        "runtime_attested",
        "runtime_attestation_missing",
        "runtime_attestation_invalid",
        "startup_cleanup_pending",
        "kill_switch_engaged",
        "orphan_cleanup_required",
        "worker_failure"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "ready"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "isolationProven": {
            "const": true
          },
          "killSwitchEngaged": {
            "const": false
          },
          "orphanCount": {
            "const": 0
          },
          "reason": {
            "const": "runtime_attested"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "killSwitchEngaged": {
            "const": true
          }
        },
        "required": [
          "killSwitchEngaged"
        ]
      },
      "then": {
        "properties": {
          "lifecycle": {
            "const": "unavailable"
          },
          "reason": {
            "const": "kill_switch_engaged"
          }
        }
      }
    }
  ]
}
