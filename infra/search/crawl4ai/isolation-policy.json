{
  "schemaVersion": 1,
  "policyId": "clervo.search.crawl4ai-isolation.v1",
  "workerId": "worker_crawl4ai_0_9_2_playwright_1_61_0",
  "versions": {
    "crawl4ai": "0.9.2",
    "playwright": "1.61.0"
  },
  "availability": "unavailable_until_runtime_attested",
  "publicRawApi": false,
  "ingress": "none",
  "egress": {
    "default": "deny",
    "onlyPeer": "clervo-retrieval-authorization-gateway:8443",
    "gatewayPolicy": "validate every document and page-asset URL, DNS answer, connected address and redirect"
  },
  "identity": {
    "runAsNonRoot": true,
    "runAsUser": 65532,
    "runAsGroup": 65532,
    "serviceAccountToken": false,
    "linuxCapabilities": []
  },
  "filesystem": {
    "rootReadOnly": true,
    "hostMounts": false,
    "hostSockets": false,
    "browserState": "per-job memory emptyDir",
    "browserStateLimitBytes": 67108864,
    "persistentSessions": false
  },
  "access": {
    "metadata": false,
    "controlPlane": false,
    "database": false,
    "commerceSecrets": false,
    "wallets": false,
    "llmIntegrations": false
  },
  "limits": {
    "cpuMillis": 1000,
    "memoryBytes": 805306368,
    "processes": 64,
    "browserPages": 1,
    "networkBytes": 16777216,
    "renderedBytes": 2097152,
    "outputCharacters": 100000,
    "ephemeralDiskBytes": 67108864,
    "executionMs": 30000
  },
  "prohibited": [
    "arbitrary_javascript",
    "hooks",
    "downloads",
    "file_urls",
    "login",
    "cookies",
    "captcha_solving",
    "proxy_rotation",
    "stealth",
    "access_control_bypass"
  ],
  "teardown": "terminate process group, remove per-job state, verify zero children, reap orphans",
  "killSwitch": "reject new jobs, terminate active process group, reap every owned orphan"
}
