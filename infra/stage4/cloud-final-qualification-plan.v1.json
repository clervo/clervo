{
  "schemaVersion": "clervo.stage4.cloud-final-qualification-plan.v1",
  "project": "bloxsniper-prod",
  "zone": "us-central1-a",
  "region": "us-central1",
  "resources": {
    "vm": "clervo-stage4-qualification",
    "firewall": "clervo-stage4-iap-ssh",
    "machineType": "e2-standard-2",
    "bootDisk": { "sizeGb": 20, "type": "pd-standard", "autoDelete": true },
    "externalIp": false,
    "ssh": { "iapOnly": true, "sourceRange": "35.235.240.0/20", "port": 22 }
  },
  "qualification": {
    "maximumExecutions": 1,
    "browserJavascriptRuns": 20,
    "browserHostileRuns": 8,
    "commerceMode": "private_mock_only",
    "realPayment": false,
    "usdcMaximum": 0,
    "externalProviderApiCashMaximumUsd": 0
  },
  "limits": {
    "maximumLifetimeSeconds": 7200,
    "maximumGrossCostUsd": 2,
    "maximumConfiguredExposureUsdPerDay": 5
  },
  "forbidden": [
    "iam_change",
    "billing_change",
    "secret_change",
    "production_change",
    "real_payment",
    "wallet_action",
    "usdc_action",
    "public_ingress",
    "legacy_action",
    "qualification_rerun"
  ],
  "cleanup": {
    "synchronous": true,
    "deleteVm": true,
    "deleteAllAttachedDisks": true,
    "deleteFirewall": true,
    "requiredResidualConfiguredExposureUsdPerDay": 0
  }
}
