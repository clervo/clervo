{
  "schemaVersion": "clervo.production-rollback-policy.v1",
  "trafficStopEnvironment": "CLERVO_TRAFFIC_MODE=stopped",
  "trafficRestoreRequires": [
    "database_readiness",
    "monitoring_delivery",
    "current_live_health"
  ],
  "rollbackTarget": "previous_verified_immutable_registry_digest",
  "rollbackFailsClosedWithoutTarget": true,
  "automaticRollbackSignals": [
    "readiness_unavailable",
    "repeated_execution_failure",
    "unknown_settlement",
    "monitoring_delivery_unavailable"
  ],
  "productionMutationRequiresOwnerApproval": true
}
