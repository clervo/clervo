{
  "schemaVersion": "clervo.production-release-policy.v1",
  "state": "current_local_container_policy",
  "container": {
    "dockerfile": "Dockerfile",
    "buildBaseImage": "node:24.18.1-bookworm-slim@sha256:235600a8101ab264e117b1768e925532262668dc9b581ef1dd7d96ced463b8e7",
    "baseImage": "gcr.io/distroless/nodejs24-debian12:nonroot@sha256:14d42e2511532589a7c7e01a753667a74fcc96266e137e8125006b87b0c32d0a",
    "user": "65532:65532",
    "readOnlyRootRequired": true,
    "noNewPrivilegesRequired": true,
    "allCapabilitiesDropped": true,
    "healthPath": "/v1/health",
    "readinessPath": "/readyz",
    "productionStateBackend": "postgres",
    "maximumConcurrentExecutions": 16,
    "requestTimeoutMs": 15000,
    "headersTimeoutMs": 5000,
    "maximumRequestsPerSocket": 100,
    "stopSignal": "SIGTERM"
  },
  "localQualification": {
    "network": "none",
    "cpu": "0.5",
    "memory": "256m",
    "pids": 64,
    "temporaryFilesystem": "/tmp",
    "providerCallsAllowed": false,
    "realPaymentsAllowed": false
  }
}
