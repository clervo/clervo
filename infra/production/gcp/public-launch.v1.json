{
  "schemaVersion": "clervo.production-public-launch.v1",
  "state": "active_production_policy",
  "project": "bloxsniper-prod",
  "region": "us-central1",
  "service": "clervo-api-production",
  "publicOrigin": "https://api.clervo.dev/",
  "edge": {
    "worker": "clervo-api-edge-production",
    "route": "api.clervo.dev/*",
    "configuration": "apps/worker/wrangler.jsonc",
    "sharedSecret": "clervo-production-edge-authorization"
  },
  "sharedBoundary": {
    "cloudRunMaximumInstances": 5,
    "containerConcurrency": 16,
    "maximumConcurrentExecutionsPerInstance": 16,
    "maximumFreeExecutionsPerInstance": 4,
    "maximumConcurrentQuotesPerInstance": 8,
    "rateLimitsPerMinute": {
      "free": 12,
      "unpaidQuote": 30,
      "paid": 180
    },
    "quoteTtlSeconds": 180,
    "originRequiresEdgeAuthorization": true,
    "absoluteDeadlinePropagation": true
  },
  "search": {
    "mode": "open_federation",
    "synthesisEnabled": true,
    "primarySecret": null,
    "fallbackSecret": null,
    "primaryCallCeiling": 8,
    "fallbackCallCeiling": 8,
    "automaticPaidOverage": false
  },
  "commerce": {
    "mode": "settlement_enabled",
    "network": "eip155:8453",
    "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
    "facilitatorUrl": "https://api.cdp.coinbase.com/platform/v2/x402",
    "protocols": ["x402", "mpp"],
    "mppMethod": "evm",
    "mppIntent": "charge",
    "mppSecret": "clervo-production-mpp-secret-key"
  },
  "sandbox": {
    "mode": "private",
    "publicMode": "paid",
    "publicRoute": true,
    "runnerDigest": "sha256:fe0c81bd0cc5b77b643d2fa0017f48aa3fcfcd470326a00c4ba3a037a09170e9",
    "priceVersion": "sandbox-run-2026-08-09.1",
    "minimumChargeAtomic": "10000",
    "maximumChargeAtomic": "60000",
    "shortSupplierCostAtomic": "8000",
    "standardSupplierCostAtomic": "45000"
  },
  "ai": {
    "mode": "paid",
    "runtimeMode": "qualified_catalog",
    "routeFamilies": "qualified_ai_supply_catalog",
    "baseUrl": "https://ai.clervo.dev/v1/",
    "clervoSecret": "clervo-production-ai-api-key",
    "groqSecret": "clervo-production-groq-api-key",
    "artifacts": {
      "mode": "r2",
      "bucket": "clervo-artifacts",
      "retentionSeconds": 604800,
      "maximumObjectBytes": 80000000,
      "accessKeyIdSecret": "clervo-production-r2-access-key-id",
      "secretAccessKeySecret": "clervo-production-r2-secret-access-key",
      "signingSecret": "clervo-production-artifact-signing-secret"
    }
  },
  "prediction": {
    "mode": "paid",
    "publicRoute": true,
    "sourceRegistry": "infra/prediction/source-routes.v1.json",
    "qualifiedAdapter": "adapter_prediction.pdata_rest",
    "qualifiedVenues": [
      "polymarket",
      "kalshi",
      "manifold",
      "limitless"
    ],
    "priceVersion": "prediction-product-2026-08-09.3",
    "supplierCostMicrousd": 0,
    "attributionRequired": true
  },
  "rpc": {
    "mode": "paid",
    "publicRoute": true,
    "drpcCredentialSecret": "clervo-production-rpc-drpc-api-key",
    "heliusCredentialSecret": "clervo-production-rpc-helius-api-key",
    "supportedChains": ["eip155:1", "eip155:10", "eip155:56", "eip155:137", "eip155:8453", "eip155:42161", "eip155:43114", "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"],
    "dailyCallCeilingPerInstance": 100000,
    "maximumBatchSize": 20,
    "priceVersion": "rpc-product-2026-08-15.1",
    "customerPriceMicrousdPerCall": 1000,
    "supplierCostMicrousdPerCall": 0,
    "archivePublic": false,
    "broadcastPublic": false
  },
  "crypto": {
    "mode": "paid",
    "publicRoute": true,
    "sourceRegistry": "infra/crypto/source-routes.v1.json",
    "qualifiedAdapter": "adapter_crypto.blockscout_value_added",
    "credentialSecret": "clervo-production-blockscout-api-key",
    "supportedChains": ["eip155:1", "eip155:8453"],
    "dailyCallCeiling": 100000,
    "priceVersion": "crypto-product-2026-08-09.1",
    "supplierCostMicrousd": 0,
    "rawApiResaleAllowed": false
  },
  "rollout": {
    "deployTrafficPercent": 0,
    "authenticatedLiveSearchSmokeRequired": true,
    "stableChallengeRequired": true,
    "sandboxLiveSmokeRequired": true,
    "predictionLiveSmokeRequired": true,
    "rpcLiveSmokeRequired": true,
    "cryptoLiveSmokeRequired": true,
    "monitoringDeliveryRequired": true,
    "currentLiveHealthRequired": true,
    "previousRevisionRequired": true,
    "previousImageDigestRequiredForRollback": true,
    "publicAccessEnabledOnlyAfterPromotion": true,
    "publicAccessMethod": "cloud_run_invoker_iam_check_disabled",
    "edgeDeployedOnlyAfterOriginVerification": true
  },
  "protectedResources": [
    "ai.clervo.dev",
    "the existing Clervo VM model gateway",
    "all unrelated and legacy cloud resources"
  ]
}
