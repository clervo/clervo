  "instructions": {
    "copyToIgnoredPath": "private/clervo-owner-inputs.json",
    "secretMountRoot": "/run/secrets/clervo",
    "secretFileMode": "0400",
    "valuesAllowedInThisManifest": "non-secret decisions, public identifiers, public wallet addresses, limits, attestations, and secret references only",
    "neverInclude": [
      "private keys",
      "seed phrases",
      "wallet signatures",
      "bearer tokens",
      "API secret values",
      "service-account key material",
      "customer payloads",
      "production credentials"
    ]
  },
