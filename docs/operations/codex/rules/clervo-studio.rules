# Permanent safety stops shared by every installed profile.
prefix_rule(pattern = ["sudo"], decision = "forbidden", justification = "The devbox has no supported privilege-escalation path; use a user-local or containerized tool.")
prefix_rule(pattern = ["su"], decision = "forbidden", justification = "Do not change OS identity from an autonomous studio session.")
prefix_rule(pattern = ["rm", "-rf"], decision = "forbidden", justification = "Use an exact recoverable cleanup procedure with ownership proof.")
prefix_rule(pattern = ["git", "reset"], decision = "forbidden", justification = "Destructive Git state rewriting is outside the studio boundary.")
prefix_rule(pattern = ["git", "clean"], decision = "forbidden", justification = "Do not delete untracked owner work.")
prefix_rule(pattern = ["git", "push", "--force"], decision = "forbidden", justification = "Force-push is irreversible and requires explicit owner approval.")
prefix_rule(pattern = ["git", "checkout", "--"], decision = "forbidden", justification = "Do not discard working-tree changes.")
prefix_rule(pattern = ["git", "restore"], decision = "forbidden", justification = "Do not discard working-tree changes.")
prefix_rule(pattern = ["docker", "system", "prune"], decision = "forbidden", justification = "Global Docker cleanup could affect unrelated workloads.")
prefix_rule(pattern = ["docker", "volume", "rm"], decision = "forbidden", justification = "Volume deletion requires exact ownership and backup proof.")
prefix_rule(pattern = ["gcloud", "billing"], decision = "forbidden", justification = "Cloud billing changes require separate owner authority.")
prefix_rule(pattern = ["gcloud", "iam"], decision = "forbidden", justification = "IAM changes require separate owner authority.")
prefix_rule(pattern = ["gcloud", "secrets"], decision = "forbidden", justification = "Secret changes require separate owner authority.")
prefix_rule(pattern = ["kubectl", "delete"], decision = "forbidden", justification = "Cluster deletion requires ownership proof and explicit approval when destructive or externally billable.")
prefix_rule(pattern = ["kubectl", "apply"], decision = "forbidden", justification = "Cluster mutation can create external cost or affect production and requires the matching owner approval.")
prefix_rule(pattern = ["terraform", ["apply", "destroy"]], decision = "forbidden", justification = "Infrastructure mutation can create cost or irreversible effects and requires the matching owner approval.")
prefix_rule(pattern = ["tofu", ["apply", "destroy"]], decision = "forbidden", justification = "Infrastructure mutation can create cost or irreversible effects and requires the matching owner approval.")
prefix_rule(pattern = ["helm", ["install", "upgrade", "uninstall"]], decision = "forbidden", justification = "Cluster mutation can create cost or production effects and requires the matching owner approval.")
prefix_rule(pattern = ["cast", "send"], decision = "forbidden", justification = "Wallet transactions and real payments are not authorized.")
prefix_rule(pattern = ["solana", "transfer"], decision = "forbidden", justification = "Wallet transactions and real payments are not authorized.")
prefix_rule(pattern = ["printenv"], decision = "forbidden", justification = "Do not enumerate environment values; inventory variable names through the redacted health script.")
