{
  "name": "@clervo/router",
  "version": "0.2.0",
  "description": "Free-first Clervo CLI for x402 payments, receipts, replay, and local spend controls on Base.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "clervo",
    "x402",
    "agent",
    "cli",
    "base",
    "usdc"
  ],
  "homepage": "https://github.com/clervo/clervo/tree/main/packages/router#readme",
  "bugs": {
    "url": "https://github.com/clervo/clervo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clervo/clervo.git",
    "directory": "packages/router"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "clervo": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@scure/bip39": "1.6.0",
    "@x402/core": "2.20.0",
    "@x402/evm": "2.20.0",
    "viem": "2.55.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
