{
  "name": "@clervo/sdk",
  "version": "0.5.2",
  "description": "TypeScript SDK for Clervo AI and agent tools with explicit x402 payment controls and replay-safe requests.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "clervo",
    "ai-agents",
    "x402",
    "search",
    "sdk"
  ],
  "homepage": "https://clervo.dev/docs/typescript",
  "bugs": {
    "url": "https://github.com/clervo/clervo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clervo/clervo.git",
    "directory": "packages/sdk-typescript"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "npm run build --workspace @clervo/router && tsc --project tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clervo/router": "0.3.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
