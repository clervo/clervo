{
  "name": "@clervo/sdk",
  "version": "0.4.0",
  "description": "Typed client for live Clervo Search and provider-neutral AI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "clervo",
    "ai-agents",
    "agent-infrastructure",
    "search",
    "sdk"
  ],
  "homepage": "https://clervo.dev/docs/typescript",
  "bugs": {
    "url": "https://github.com/clervo/clervo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clervo/clervo.git",
    "directory": "packages/sdk-typescript"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
