{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/live-intelligence-monitor-definition.schema.json",
  "title": "Clervo Live Intelligence monitor definition",
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "type": "object",
  "required": ["contractVersion", "schemaVersion", "monitorId", "revision", "query", "schedule", "retention", "createdAt", "definitionHash"],
  "properties": {
    "contractVersion": { "const": "2026-07-29.1" },
    "schemaVersion": { "const": "live-intelligence-monitor-definition.v1" },
    "monitorId": { "type": "string", "pattern": "^mon_[A-Za-z0-9]{20,64}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "query": {
      "type": "object",
      "required": ["text", "language", "region", "identityHash"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "language": { "type": "string", "minLength": 2, "maxLength": 35, "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
        "region": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "identityHash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "required": ["anchorAt", "intervalSeconds"],
      "properties": {
        "anchorAt": { "$ref": "#/$defs/timestamp" },
        "intervalSeconds": { "type": "integer", "minimum": 60, "maximum": 2592000 }
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "required": ["maximumSnapshots", "maximumAgeSeconds"],
      "properties": {
        "maximumSnapshots": { "type": "integer", "minimum": 2, "maximum": 10000 },
        "maximumAgeSeconds": { "type": "integer", "minimum": 60, "maximum": 31536000 }
      },
      "additionalProperties": false
    },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "definitionHash": { "$ref": "#/$defs/hash" }
  },
  "additionalProperties": false
}
