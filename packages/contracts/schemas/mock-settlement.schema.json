{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/mock-settlement.schema.json",
  "title": "Clervo mock settlement or quarantine evidence",
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "amount": {
      "type": "object",
      "required": ["asset", "amountAtomic", "decimals"],
      "properties": {
        "asset": { "type": "string", "pattern": "^mock:[A-Za-z0-9._-]{2,123}$" },
        "amountAtomic": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,77})$" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 30 }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["contractVersion", "settlementId", "operationId", "authorizationHash", "amount", "outcome", "observedAt", "settlementHash"],
  "properties": {
    "contractVersion": { "const": "2026-07-29.1" },
    "settlementId": { "type": "string", "pattern": "^settle_[A-Za-z0-9]{20,64}$" },
    "operationId": { "type": "string", "pattern": "^op_[A-Za-z0-9]{20,64}$" },
    "authorizationHash": { "$ref": "#/$defs/hash" },
    "amount": { "$ref": "#/$defs/amount" },
    "outcome": { "enum": ["settled", "unknown"] },
    "referenceHash": { "$ref": "#/$defs/hash" },
    "observedAt": { "type": "string", "format": "date-time" },
    "settlementHash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "outcome": { "const": "settled" } }, "required": ["outcome"] },
      "then": {
        "type": "object",
        "properties": { "referenceHash": { "$ref": "#/$defs/hash" } },
        "required": ["referenceHash"]
      }
    },
    {
      "if": { "type": "object", "properties": { "outcome": { "const": "unknown" } }, "required": ["outcome"] },
      "then": { "not": { "required": ["referenceHash"] } }
    }
  ],
  "additionalProperties": false
}