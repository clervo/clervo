{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/development-retrieval-supply.schema.json",
  "title": "Clervo development-only concrete retrieval supply qualification",
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["name", "url", "observedAt", "summary", "sha256"],
      "properties": {
        "name": { "enum": ["identity", "capability", "health", "bounded_use", "terms"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "observedAt": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "minLength": 5, "maxLength": 500 },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "sourceId", "providerId", "observedProviderId", "failureDomain", "role", "mechanism",
        "qualificationStatus", "checkedAt", "expiresAt", "capabilities", "healthStatus", "quotaStatus",
        "termsStatus", "restrictionsAcknowledged", "resaleStatus", "safeFailure", "substitutionPolicy",
        "evidence", "developmentEligible", "productionEligible", "failureCodes"
      ],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^source_[a-z0-9][a-z0-9._-]{2,63}$" },
        "providerId": { "type": "string", "pattern": "^provider_[a-z0-9][a-z0-9._-]{2,63}$" },
        "observedProviderId": { "type": "string", "pattern": "^provider_[a-z0-9][a-z0-9._-]{2,63}$" },
        "failureDomain": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
        "role": { "enum": ["broker_upstream", "direct_archive"] },
        "mechanism": { "enum": ["searxng_engine", "common_crawl_direct"] },
        "qualificationStatus": { "enum": ["passed", "provisional", "blocked"] },
        "checkedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" }
        },
        "healthStatus": { "enum": ["healthy", "unavailable", "not_run"] },
        "quotaStatus": { "enum": ["known", "bounded", "unknown"] },
        "requestCeiling": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "costCeilingUsdMicros": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "termsStatus": { "enum": ["permitted", "restricted", "prohibited", "unknown"] },
        "restrictionsAcknowledged": { "type": "boolean" },
        "resaleStatus": { "enum": ["permitted", "permitted_with_attribution", "prohibited", "legal_review_required", "unknown"] },
        "safeFailure": { "const": "fail_closed" },
        "substitutionPolicy": { "const": "exact" },
        "evidence": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "developmentEligible": { "type": "boolean" },
        "productionEligible": { "type": "boolean" },
        "failureCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,95}$" }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "contractVersion", "qualificationId", "n419DecisionId", "evaluatedAt", "environment",
    "productionAuthorization", "broker", "archive", "brokerReady", "archiveReady",
    "developmentReady", "productionReady", "result", "failureCodes", "productionBlockers"
  ],
  "properties": {
    "contractVersion": { "const": "2026-07-29.1" },
    "qualificationId": { "type": "string", "pattern": "^dsqual_[A-Za-z0-9]{20,64}$" },
    "n419DecisionId": { "type": "string", "pattern": "^rsupply_[A-Za-z0-9]{20,64}$" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "environment": { "const": "development" },
    "productionAuthorization": { "const": false },
    "broker": {
      "type": "object",
      "required": [
        "brokerId", "softwareId", "observedVersion", "deployment", "endpointScope",
        "qualificationStatus", "healthStatus", "checkedAt", "expiresAt", "evidence", "upstreams", "failureCodes"
      ],
      "properties": {
        "brokerId": { "type": "string", "pattern": "^broker_[a-z0-9][a-z0-9._-]{2,63}$" },
        "softwareId": { "const": "searxng" },
        "observedVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "deployment": { "enum": ["self_hosted", "public_shared"] },
        "endpointScope": { "enum": ["loopback_only", "remote_public"] },
        "qualificationStatus": { "enum": ["passed", "provisional", "blocked"] },
        "healthStatus": { "enum": ["healthy", "unavailable", "not_run"] },
        "checkedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "upstreams": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/source" } },
        "failureCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,95}$" }
        }
      },
      "additionalProperties": false
    },
    "archive": { "$ref": "#/$defs/source" },
    "brokerReady": { "type": "boolean" },
    "archiveReady": { "type": "boolean" },
    "developmentReady": { "type": "boolean" },
    "productionReady": { "const": false },
    "result": { "enum": ["verified", "provisional", "degraded", "blocked"] },
    "failureCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,95}$" }
    },
    "productionBlockers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.]{2,127}$" }
    }
  },
  "additionalProperties": false
}
