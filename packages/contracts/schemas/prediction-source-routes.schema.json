{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/prediction-source-routes.schema.json",
  "type": "object",
  "required": ["schemaVersion", "lifecycle", "customerRoutingEnabled", "sources", "ownerBlocker"],
  "properties": {
    "schemaVersion": { "const": "clervo.prediction-source-routes.v1" },
    "lifecycle": { "enum": ["unavailable", "live"] },
    "customerRoutingEnabled": { "type": "boolean" },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["sourceId", "adapterId", "qualificationId", "accessMode", "technicalQualification", "technicalObservedAt", "technicalExpiresAt", "commercialPermission", "publicSellable", "outputMode", "rawPassThroughPermitted", "historyPermission", "retentionDays", "attributionRequirement", "publishedRateLimit", "customerRoutingEnabled", "evidenceUrls"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^prediction\\.source\\.[a-z0-9_]+$" },
          "venueId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "venueIds": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" } },
          "adapterId": { "type": "string", "pattern": "^adapter_prediction\\.[a-z0-9_]+$" },
          "qualificationId": { "type": "string", "pattern": "^qual_[A-Za-z0-9]{20,64}$" },
          "accessMode": { "enum": ["public_api", "partner_api", "owned"] },
          "technicalQualification": { "enum": ["qualified", "expired", "failed", "not_run"] },
          "technicalObservedAt": { "type": "string", "format": "date-time" },
          "technicalExpiresAt": { "type": "string", "format": "date-time" },
          "qualificationEvidence": { "type": "object", "required": ["repeatedCalls", "successes", "failures", "latencyMs", "normalizationPassed", "freshness"], "properties": {
            "repeatedCalls": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "successes": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "failures": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "latencyMs": { "type": "object", "required": ["minimum", "median", "maximum"], "properties": { "minimum": { "type": "number", "minimum": 0 }, "median": { "type": "number", "minimum": 0 }, "maximum": { "type": "number", "minimum": 0 } }, "additionalProperties": false },
            "normalizationPassed": { "type": "boolean" },
            "freshness": { "enum": ["fresh", "stale"] }
          }, "additionalProperties": false },
          "commercialPermission": { "enum": ["approved", "unresolved", "restricted", "prohibited"] },
          "publicSellable": { "type": "boolean" },
          "outputMode": { "enum": ["derived_only", "raw_and_derived"] },
          "rawPassThroughPermitted": { "enum": ["approved", "unknown", "prohibited"] },
          "historyPermission": { "enum": ["approved", "unresolved", "restricted", "prohibited"] },
          "retentionDays": { "type": ["integer", "null"], "minimum": 1, "maximum": 3650 },
          "attributionRequirement": { "enum": ["required", "not_required", "unknown"] },
          "publishedRateLimit": { "type": "string", "minLength": 1, "maxLength": 100 },
          "commercialRights": {
            "type": "object",
            "required": ["basis", "licenseId", "licenseUrl", "commercialUse", "adaptation", "redistribution", "apiReuse", "competingServiceRestriction", "upstreamProvenance", "termsObservedAt", "attributionNotice", "changesNotice"],
            "properties": {
              "basis": { "enum": ["explicit_public_license", "owner_written_approval"] },
              "licenseId": { "type": "string", "minLength": 1, "maxLength": 100 },
              "licenseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
              "commercialUse": { "const": true },
              "adaptation": { "const": true },
              "redistribution": { "const": true },
              "apiReuse": { "const": true },
              "competingServiceRestriction": { "enum": ["none_published", "owner_waived"] },
              "upstreamProvenance": { "type": "string", "minLength": 1, "maxLength": 300 },
              "termsObservedAt": { "type": "string", "format": "date-time" },
              "attributionNotice": { "type": "string", "minLength": 1, "maxLength": 500 },
              "changesNotice": { "type": "string", "minLength": 1, "maxLength": 500 }
            },
            "additionalProperties": false
          },
          "customerRoutingEnabled": { "type": "boolean" },
          "evidenceUrls": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } }
        },
        "oneOf": [
          { "required": ["venueId"], "properties": { "venueId": true }, "not": { "required": ["venueIds"], "properties": { "venueIds": true } } },
          { "required": ["venueIds"], "properties": { "venueIds": true }, "not": { "required": ["venueId"], "properties": { "venueId": true } } }
        ],
        "allOf": [
          { "if": { "anyOf": [
            { "properties": { "technicalQualification": { "enum": ["expired", "failed", "not_run"] } }, "required": ["technicalQualification"] },
            { "properties": { "commercialPermission": { "enum": ["unresolved", "restricted", "prohibited"] } }, "required": ["commercialPermission"] },
            { "properties": { "publicSellable": { "const": false } }, "required": ["publicSellable"] }
          ] }, "then": { "properties": { "customerRoutingEnabled": { "const": false } } } },
          { "if": { "properties": { "commercialPermission": { "const": "approved" } }, "required": ["commercialPermission"] }, "then": { "required": ["commercialRights"], "properties": { "commercialRights": true, "attributionRequirement": { "enum": ["required", "not_required"] } } } }
        ],
        "additionalProperties": false
      }
    },
    "ownerBlocker": { "type": "string", "minLength": 1, "maxLength": 400 }
  },
  "allOf": [
    { "if": { "properties": { "customerRoutingEnabled": { "const": true } }, "required": ["customerRoutingEnabled"] }, "then": { "properties": { "lifecycle": { "const": "live" } } } },
    { "if": { "properties": { "lifecycle": { "const": "unavailable" } }, "required": ["lifecycle"] }, "then": { "properties": { "customerRoutingEnabled": { "const": false } } } }
  ],
  "additionalProperties": false
}
