{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/prediction-source-routes.schema.json",
  "type": "object",
  "required": ["schemaVersion", "lifecycle", "customerRoutingEnabled", "sources", "ownerBlocker"],
  "properties": {
    "schemaVersion": { "const": "clervo.prediction-source-routes.v1" },
    "lifecycle": { "const": "unavailable" },
    "customerRoutingEnabled": { "const": false },
    "sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["sourceId", "venueId", "accessMode", "technicalStatus", "termsStatus", "resaleStatus", "historyStatus", "quoteStatus", "orderBookStatus", "onChainVerified", "customerRoutingEnabled", "evidenceUrls"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^prediction\\.source\\.[a-z0-9_]+$" },
          "venueId": { "enum": ["polymarket", "kalshi"] },
          "accessMode": { "const": "public_api" },
          "technicalStatus": { "enum": ["recorded_fixture_passed", "live_passed", "failed", "not_run"] },
          "termsStatus": { "enum": ["approved", "unreviewed", "restricted", "blocked"] },
          "resaleStatus": { "enum": ["approved", "unreviewed", "restricted", "prohibited"] },
          "historyStatus": { "enum": ["approved", "unreviewed", "restricted", "prohibited"] },
          "quoteStatus": { "enum": ["recorded_only", "live_qualified", "unqualified"] },
          "orderBookStatus": { "enum": ["recorded_only", "live_qualified", "unqualified", "unsupported"] },
          "onChainVerified": { "type": "boolean" },
          "customerRoutingEnabled": { "type": "boolean" },
          "evidenceUrls": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                { "properties": { "technicalStatus": { "enum": ["recorded_fixture_passed", "failed", "not_run"] } }, "required": ["technicalStatus"] },
                { "properties": { "termsStatus": { "enum": ["unreviewed", "restricted", "blocked"] } }, "required": ["termsStatus"] },
                { "properties": { "resaleStatus": { "enum": ["unreviewed", "restricted", "prohibited"] } }, "required": ["resaleStatus"] }
              ]
            },
            "then": { "properties": { "customerRoutingEnabled": { "const": false } } }
          }
        ],
        "additionalProperties": false
      }
    },
    "ownerBlocker": { "type": "string", "minLength": 1, "maxLength": 300 }
  },
  "additionalProperties": false
}
