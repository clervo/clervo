{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/sandbox-operation-request.schema.json",
  "title": "Clervo bounded sandbox operation request",
  "$defs": {
    "limits": {
      "type": "object", "required": ["cpuMillis", "memoryBytes", "processes", "diskBytes", "outputBytes", "artifactBytes", "wallTimeMs"],
      "properties": {
        "cpuMillis": { "type": "integer", "minimum": 1, "maximum": 300000 }, "memoryBytes": { "type": "integer", "minimum": 16777216, "maximum": 8589934592 },
        "processes": { "type": "integer", "minimum": 1, "maximum": 256 }, "diskBytes": { "type": "integer", "minimum": 1048576, "maximum": 10737418240 },
        "outputBytes": { "type": "integer", "minimum": 1, "maximum": 10485760 }, "artifactBytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
        "wallTimeMs": { "type": "integer", "minimum": 100, "maximum": 300000 }
      }, "additionalProperties": false
    },
    "command": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" } },
    "stdin": { "type": "string", "maxLength": 1398104, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
  },
  "type": "object", "required": ["contractVersion", "schemaVersion", "operationId", "productId", "input", "maximumCharge", "deadlineAt"],
  "properties": {
    "contractVersion": { "const": "2026-07-29.1" }, "schemaVersion": { "const": "sandbox-operation-request.v1" }, "operationId": { "type": "string", "pattern": "^op_[A-Za-z0-9]{20,64}$" },
    "productId": { "enum": ["sandbox.run", "sandbox.session.create", "sandbox.session.exec", "sandbox.artifact.get", "sandbox.session.destroy"] },
    "input": { "oneOf": [
      { "type": "object", "required": ["kind", "executionId", "imageDigest", "command", "limits"], "properties": { "kind": { "const": "run" }, "executionId": { "type": "string", "pattern": "^exec_[A-Za-z0-9]{20,64}$" }, "imageDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "command": { "$ref": "#/$defs/command" }, "stdinBase64": { "$ref": "#/$defs/stdin" }, "limits": { "$ref": "#/$defs/limits" } }, "additionalProperties": false },
      { "type": "object", "required": ["kind", "imageDigest", "limits", "ttlMs"], "properties": { "kind": { "const": "session_create" }, "imageDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "limits": { "$ref": "#/$defs/limits" }, "ttlMs": { "type": "integer", "minimum": 1000, "maximum": 900000 } }, "additionalProperties": false },
      { "type": "object", "required": ["kind", "sessionId", "executionId", "command"], "properties": { "kind": { "const": "session_exec" }, "sessionId": { "type": "string", "pattern": "^sbx_[A-Za-z0-9]{20,64}$" }, "executionId": { "type": "string", "pattern": "^exec_[A-Za-z0-9]{20,64}$" }, "command": { "$ref": "#/$defs/command" }, "stdinBase64": { "$ref": "#/$defs/stdin" } }, "additionalProperties": false },
      { "type": "object", "required": ["kind", "artifactId"], "properties": { "kind": { "const": "artifact_get" }, "artifactId": { "type": "string", "pattern": "^art_[a-f0-9]{32}$" } }, "additionalProperties": false },
      { "type": "object", "required": ["kind", "sessionId"], "properties": { "kind": { "const": "session_destroy" }, "sessionId": { "type": "string", "pattern": "^sbx_[A-Za-z0-9]{20,64}$" } }, "additionalProperties": false }
    ] },
    "maximumCharge": { "type": "object", "required": ["asset", "amountAtomic", "decimals"], "properties": { "asset": { "const": "USD" }, "amountAtomic": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,6})$" }, "decimals": { "const": 6 } }, "additionalProperties": false },
    "deadlineAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "productId": { "const": "sandbox.run" } }, "required": ["productId"] }, "then": { "properties": { "input": { "type": "object", "properties": { "kind": { "const": "run" } }, "required": ["kind"] } } } },
    { "if": { "properties": { "productId": { "const": "sandbox.session.create" } }, "required": ["productId"] }, "then": { "properties": { "input": { "type": "object", "properties": { "kind": { "const": "session_create" } }, "required": ["kind"] } } } },
    { "if": { "properties": { "productId": { "const": "sandbox.session.exec" } }, "required": ["productId"] }, "then": { "properties": { "input": { "type": "object", "properties": { "kind": { "const": "session_exec" } }, "required": ["kind"] } } } },
    { "if": { "properties": { "productId": { "const": "sandbox.artifact.get" } }, "required": ["productId"] }, "then": { "properties": { "input": { "type": "object", "properties": { "kind": { "const": "artifact_get" } }, "required": ["kind"] } } } },
    { "if": { "properties": { "productId": { "const": "sandbox.session.destroy" } }, "required": ["productId"] }, "then": { "properties": { "input": { "type": "object", "properties": { "kind": { "const": "session_destroy" } }, "required": ["kind"] } } } }
  ],
  "additionalProperties": false
}
