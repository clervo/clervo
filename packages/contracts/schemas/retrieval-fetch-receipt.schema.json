{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/retrieval-fetch-receipt.schema.json",
  "title": "Clervo bounded retrieval fetch receipt",
  "$defs": {
    "hop": {
      "type": "object",
      "required": ["kind", "url", "resolvedAddresses", "connectedAddress", "status"],
      "properties": {
        "kind": { "enum": ["robots", "content"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "resolvedAddresses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "oneOf": [{ "format": "ipv4" }, { "format": "ipv6" }] } },
        "connectedAddress": { "type": "string", "oneOf": [{ "format": "ipv4" }, { "format": "ipv6" }] },
        "status": { "type": "integer", "minimum": 100, "maximum": 599 }
      },
      "additionalProperties": false
    },
    "robots": {
      "type": "object",
      "required": ["status", "cacheHit"],
      "properties": {
        "status": { "enum": ["allowed", "disallowed", "unavailable", "not_applicable"] },
        "cacheHit": { "type": "boolean" },
        "robotsUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "fetchedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["contractVersion", "fetchId", "outcome", "requestedUrl", "startedAt", "completedAt", "hops", "robots"],
  "properties": {
    "contractVersion": { "const": "2026-07-29.1" },
    "fetchId": { "type": "string", "pattern": "^fetch_[A-Za-z0-9]{20,64}$" },
    "outcome": { "enum": ["succeeded", "rejected"] },
    "requestedUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "finalUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "hops": { "type": "array", "maxItems": 42, "items": { "$ref": "#/$defs/hop" } },
    "robots": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/robots" } },
    "contentType": { "enum": ["text/html", "text/plain", "application/xhtml+xml", "application/json", "application/pdf"] },
    "contentLengthBytes": { "type": "integer", "minimum": 0 },
    "bodySha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "failureCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,95}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "succeeded" } }, "required": ["outcome"] },
      "then": {
        "required": ["finalUrl", "contentType", "contentLengthBytes", "bodySha256"],
        "properties": {
          "finalUrl": true,
          "contentType": true,
          "contentLengthBytes": true,
          "bodySha256": true,
          "failureCode": false,
          "hops": { "type": "array", "minItems": 1, "contains": { "type": "object", "properties": { "kind": { "const": "content" } }, "required": ["kind"] } },
          "robots": { "type": "array", "minItems": 1, "contains": { "type": "object", "properties": { "status": { "enum": ["allowed", "not_applicable"] } }, "required": ["status"] } }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "rejected" } }, "required": ["outcome"] },
      "then": {
        "required": ["failureCode"],
        "properties": { "failureCode": true, "contentType": false, "contentLengthBytes": false, "bodySha256": false }
      }
    }
  ],
  "additionalProperties": false
}