{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/ai-route-qualification.schema.json",
  "title": "Clervo AI route qualification",
  "$defs": {
    "productId": { "enum": ["ai.chat", "ai.embed", "ai.image", "ai.speech"] },
    "amount": {
      "type": "object",
      "required": ["asset", "amountAtomic", "decimals"],
      "properties": {
        "asset": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{1,127}$" },
        "amountAtomic": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,77})$" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 30 }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["contractVersion", "schemaVersion", "qualificationId", "routeId", "providerId", "supplyFamilyId", "exactModelId", "productIds", "checkedAt", "expiresAt", "status", "termsStatus", "resaleAllowed", "checks", "observed", "qualificationHash"],
  "properties": {
    "contractVersion": { "const": "2026-07-29.1" },
    "schemaVersion": { "const": "ai-route-qualification.v1" },
    "qualificationId": { "type": "string", "pattern": "^aiqual_[A-Za-z0-9]{20,64}$" },
    "routeId": { "type": "string", "pattern": "^ai\\.route\\.[a-z0-9_]+$" },
    "providerId": { "type": "string", "pattern": "^provider\\.[a-z0-9_]+$" },
    "supplyFamilyId": { "type": "string", "pattern": "^supply\\.[a-z0-9_]+$" },
    "exactModelId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "productIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/productId" } },
    "checkedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["passed", "failed", "blocked"] },
    "termsStatus": { "enum": ["approved", "restricted", "blocked", "unreviewed"] },
    "resaleAllowed": { "type": "boolean" },
    "checks": {
      "type": "array",
      "minItems": 9,
      "maxItems": 11,
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "enum": ["authentication", "exact_identity", "input_dependence", "output_shape", "usage_reporting", "latency", "failure_handling", "cost_ceiling", "terms", "streaming", "structured_output"] },
          "status": { "enum": ["passed", "failed", "not_run"] },
          "evidenceHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" }
        },
        "additionalProperties": false
      }
    },
    "observed": {
      "type": "object",
      "properties": {
        "modelIdentity": { "type": "string", "minLength": 1, "maxLength": 160 },
        "latencyMsP95": { "type": "number", "minimum": 0 },
        "maximumSupplierCost": { "$ref": "#/$defs/amount" }
      },
      "additionalProperties": false
    },
    "qualificationHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
