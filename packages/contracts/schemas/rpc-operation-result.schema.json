{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/rpc-operation-result.schema.json",
  "$defs": {
    "json": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/json" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/json" } }
      ]
    },
    "chainId": { "type": "string", "pattern": "^(?:eip155:[1-9][0-9]{0,9}|solana:[A-Za-z0-9]{8,64})$" },
    "charge": {
      "type": "object",
      "required": ["asset", "amountAtomic", "decimals"],
      "properties": { "asset": { "const": "USD" }, "amountAtomic": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,6})$" }, "decimals": { "const": 6 } },
      "additionalProperties": false
    },
    "outcome": {
      "oneOf": [
        { "type": "object", "required": ["id", "ok", "result"], "properties": { "id": { "type": "integer", "minimum": 1, "maximum": 100 }, "ok": { "const": true }, "result": { "$ref": "#/$defs/json" } }, "additionalProperties": false },
        { "type": "object", "required": ["id", "ok", "error"], "properties": { "id": { "type": "integer", "minimum": 1, "maximum": 100 }, "ok": { "const": false }, "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "integer", "minimum": -32768, "maximum": 32767 }, "message": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" } }, "additionalProperties": false } }, "additionalProperties": false }
      ]
    }
  },
  "type": "object",
  "required": ["contractVersion", "schemaVersion", "operationId", "productId", "completedAt", "meteredCharge", "output", "resultHash"],
  "properties": {
    "contractVersion": { "const": "2026-07-29.1" },
    "schemaVersion": { "const": "rpc-operation-result.v1" },
    "operationId": { "type": "string", "pattern": "^op_[A-Za-z0-9]{20,64}$" },
    "productId": { "enum": ["rpc.call", "rpc.batch", "rpc.health", "rpc.archive", "rpc.broadcast"] },
    "completedAt": { "type": "string", "format": "date-time" },
    "meteredCharge": { "$ref": "#/$defs/charge" },
    "output": {
      "oneOf": [
        { "type": "object", "required": ["kind", "chainId", "outcomes", "cache", "quorum", "observedAt", "requestHash"], "properties": { "kind": { "const": "rpc" }, "chainId": { "$ref": "#/$defs/chainId" }, "outcomes": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/outcome" } }, "cache": { "enum": ["hit", "miss", "bypass"] }, "quorum": { "enum": [1, 2, 3] }, "observedAt": { "type": "string", "format": "date-time" }, "requestHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "chainId", "status", "healthyRoutes", "highestHeight", "quorumAvailable", "observedAt"], "properties": { "kind": { "const": "health" }, "chainId": { "$ref": "#/$defs/chainId" }, "status": { "enum": ["healthy", "degraded", "unavailable"] }, "healthyRoutes": { "type": "integer", "minimum": 0, "maximum": 128 }, "highestHeight": { "type": ["integer", "null"], "minimum": 0 }, "quorumAvailable": { "type": "boolean" }, "observedAt": { "type": "string", "format": "date-time" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "chainId", "state", "transactionId", "replayed", "requestHash"], "properties": { "kind": { "const": "broadcast" }, "chainId": { "$ref": "#/$defs/chainId" }, "state": { "enum": ["submitted", "confirmed", "rejected", "unknown"] }, "transactionId": { "type": ["string", "null"], "pattern": "^(?:0x[0-9a-fA-F]{64}|[1-9A-HJ-NP-Za-km-z]{32,128})$" }, "replayed": { "type": "boolean" }, "requestHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }, "additionalProperties": false }
      ]
    },
    "resultHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
