{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/product-scope.schema.json",
  "title": "Clervo product release scope",
  "type": "object",
  "required": ["scopeVersion", "company", "firstRevenueRelease", "fullPlatformExpansion", "pillars"],
  "properties": {
    "scopeVersion": { "const": "2026-07-31.2" },
    "company": {
      "type": "object",
      "required": ["name", "identity", "permanentNarrative"],
      "properties": {
        "name": { "const": "Clervo" },
        "identity": { "const": "outcome infrastructure for agents" },
        "permanentNarrative": { "const": ["find", "understand", "act"] }
      },
      "additionalProperties": false
    },
    "firstRevenueRelease": {
      "type": "object",
      "required": ["productId", "productName", "requiredPillars", "requirements", "ready"],
      "properties": {
        "productId": { "const": "clervo.live_intelligence" },
        "productName": { "const": "Clervo Live Intelligence" },
        "requiredPillars": { "const": ["search"] },
        "requirements": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["requirementId", "verified"],
            "properties": {
              "requirementId": { "enum": ["search", "fetch", "extract", "provenance_exact_citations", "compare", "monitoring", "changes", "alerts", "machine_readable_api", "mcp_sdk_access", "bounded_pricing_receipts", "tested_onboarding", "production_deployment", "public_product_pages_documentation", "real_demonstrations", "external_useful_paid_result"] },
              "verified": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "ready": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "fullPlatformExpansion": {
      "type": "object",
      "required": ["requiredPillars", "ready"],
      "properties": {
        "requiredPillars": { "const": ["search", "ai", "sandbox", "rpc", "prediction", "crypto_intelligence"] },
        "ready": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "pillars": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["pillarId", "release", "lifecycle", "capabilityIds"],
        "properties": {
          "pillarId": { "enum": ["search", "ai", "sandbox", "rpc", "prediction", "crypto_intelligence"] },
          "release": { "enum": ["first_revenue_release", "additive_expansion", "later_platform_expansion"] },
          "lifecycle": { "enum": ["available", "degraded", "preview", "planned_post_launch", "unavailable"] },
          "capabilityIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._][a-z][a-z0-9]*)+$" } }
        },
        "allOf": [
          {
            "if": { "properties": { "release": { "enum": ["additive_expansion", "later_platform_expansion"] } }, "required": ["release"] },
            "then": { "properties": { "lifecycle": { "enum": ["planned_post_launch", "unavailable"] } } }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
