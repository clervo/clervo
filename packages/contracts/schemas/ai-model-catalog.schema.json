{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/ai-model-catalog.schema.json",
  "title": "Clervo internal AI model catalog",
  "$defs": {
    "productId": { "enum": ["ai.chat", "ai.embed", "ai.image", "ai.speech"] },
    "capability": { "enum": ["text_input", "text_output", "image_input", "image_output", "embedding_output", "audio_output", "streaming", "structured_output", "tool_calling", "reasoning"] }
  },
  "type": "object",
  "required": ["contractVersion", "schemaVersion", "catalogId", "evaluatedAt", "routes", "qualifiedSupplyFamilies", "catalogHash"],
  "properties": {
    "contractVersion": { "const": "2026-07-29.1" },
    "schemaVersion": { "const": "ai-model-catalog.v1" },
    "catalogId": { "type": "string", "pattern": "^aicat_[A-Za-z0-9]{20,64}$" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["routeId", "providerId", "supplyFamilyId", "exactModelId", "productIds", "capabilities", "requiredSecretNames", "quickAiPremium", "qualification"],
        "properties": {
          "routeId": { "type": "string", "pattern": "^ai\\.route\\.[a-z0-9_]+$" },
          "providerId": { "type": "string", "pattern": "^provider\\.[a-z0-9_]+$" },
          "supplyFamilyId": { "type": "string", "pattern": "^supply\\.[a-z0-9_]+$" },
          "exactModelId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "productIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/productId" } },
          "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } },
          "requiredSecretNames": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" } },
          "quickAiPremium": { "type": "boolean" },
          "qualification": { "$ref": "https://api.clervo.dev/schemas/2026-07-29.1/ai-route-qualification.schema.json" }
        },
        "additionalProperties": false
      }
    },
    "qualifiedSupplyFamilies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^supply\\.[a-z0-9_]+$" } },
    "catalogHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
