{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/rpc-provider-routes.schema.json",
  "type": "object",
  "required": ["schemaVersion", "lifecycle", "customerRoutingEnabled", "routes", "evidence"],
  "properties": {
    "schemaVersion": { "const": "clervo.rpc-provider-routes.v1" },
    "lifecycle": { "const": "unavailable" },
    "customerRoutingEnabled": { "const": false },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["routeId", "chainId", "serviceId", "technicalStatus", "termsStatus", "resaleStatus", "customerRoutingEnabled", "archiveQualified", "broadcastQualified", "semanticMethods"],
        "properties": {
          "routeId": { "type": "string", "pattern": "^rpc\\.route\\.[a-z0-9][a-z0-9._-]{2,63}$" },
          "chainId": { "type": "string", "pattern": "^(?:eip155:[1-9][0-9]{0,9}|solana:[A-Za-z0-9]{8,64})$" },
          "serviceId": { "type": "string", "pattern": "^supply\\.[a-z0-9_]+$" },
          "technicalStatus": { "enum": ["passed", "failed", "not_run"] },
          "termsStatus": { "enum": ["approved", "restricted", "blocked", "unreviewed"] },
          "resaleStatus": { "enum": ["approved", "restricted", "prohibited", "unreviewed"] },
          "customerRoutingEnabled": { "type": "boolean" },
          "archiveQualified": { "type": "boolean" },
          "broadcastQualified": { "type": "boolean" },
          "semanticMethods": { "type": "array", "minItems": 3, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{1,63}$" } }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                { "properties": { "technicalStatus": { "const": "failed" } }, "required": ["technicalStatus"] },
                { "properties": { "termsStatus": { "enum": ["restricted", "blocked", "unreviewed"] } }, "required": ["termsStatus"] },
                { "properties": { "resaleStatus": { "enum": ["restricted", "prohibited", "unreviewed"] } }, "required": ["resaleStatus"] }
              ]
            },
            "then": { "properties": { "customerRoutingEnabled": { "const": false }, "archiveQualified": { "const": false }, "broadcastQualified": { "const": false } } }
          }
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "required": ["inventory", "pricing", "ownerBlocker"],
      "properties": {
        "inventory": { "const": "packages/catalog/external-supply-inventory.v1.json" },
        "pricing": { "const": "packages/catalog/rpc-supply-pricing.v1.json" },
        "ownerBlocker": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
