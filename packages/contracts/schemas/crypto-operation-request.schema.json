{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/crypto-operation-request.schema.json",
  "$defs": {
    "chains": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["eip155:1", "eip155:8453"] } },
    "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
    "charge": { "type": "object", "required": ["asset", "amountAtomic", "decimals"], "properties": { "asset": { "const": "USD" }, "amountAtomic": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,6})$" }, "decimals": { "const": 6 } }, "additionalProperties": false }
  },
  "type": "object",
  "required": ["contractVersion", "schemaVersion", "operationId", "productId", "input", "maximumCharge", "deadlineAt"],
  "properties": {
    "contractVersion": { "const": "2026-07-29.1" },
    "schemaVersion": { "const": "crypto-operation-request.v1" },
    "operationId": { "type": "string", "pattern": "^op_[A-Za-z0-9]{20,64}$" },
    "productId": { "enum": ["crypto.wallet.balances", "crypto.wallet.tokens", "crypto.wallet.transactions", "crypto.wallet.report"] },
    "input": {
      "oneOf": [
        { "type": "object", "required": ["kind", "address", "chains"], "properties": { "kind": { "const": "balances" }, "address": { "$ref": "#/$defs/address" }, "chains": { "$ref": "#/$defs/chains" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "address", "chains"], "properties": { "kind": { "const": "tokens" }, "address": { "$ref": "#/$defs/address" }, "chains": { "$ref": "#/$defs/chains" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "address", "chains", "lookbackDays", "limit"], "properties": { "kind": { "const": "transactions" }, "address": { "$ref": "#/$defs/address" }, "chains": { "$ref": "#/$defs/chains" }, "lookbackDays": { "type": "integer", "minimum": 1, "maximum": 90 }, "limit": { "type": "integer", "minimum": 1, "maximum": 50 } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "address", "chains", "lookbackDays", "limit"], "properties": { "kind": { "const": "report" }, "address": { "$ref": "#/$defs/address" }, "chains": { "$ref": "#/$defs/chains" }, "lookbackDays": { "type": "integer", "minimum": 1, "maximum": 90 }, "limit": { "type": "integer", "minimum": 1, "maximum": 50 } }, "additionalProperties": false }
      ]
    },
    "maximumCharge": { "$ref": "#/$defs/charge" },
    "deadlineAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "productId": { "const": "crypto.wallet.balances" } }, "required": ["productId"] }, "then": { "properties": { "input": { "type": "object", "properties": { "kind": { "const": "balances" } } } } } },
    { "if": { "properties": { "productId": { "const": "crypto.wallet.tokens" } }, "required": ["productId"] }, "then": { "properties": { "input": { "type": "object", "properties": { "kind": { "const": "tokens" } } } } } },
    { "if": { "properties": { "productId": { "const": "crypto.wallet.transactions" } }, "required": ["productId"] }, "then": { "properties": { "input": { "type": "object", "properties": { "kind": { "const": "transactions" } } } } } },
    { "if": { "properties": { "productId": { "const": "crypto.wallet.report" } }, "required": ["productId"] }, "then": { "properties": { "input": { "type": "object", "properties": { "kind": { "const": "report" } } } } } }
  ],
  "additionalProperties": false
}
