{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/blockchain-data-supply-pricing.schema.json",
  "title": "Clervo internal blockchain-data supply pricing",
  "type": "object",
  "required": ["schemaVersion", "priceVersion", "effectiveAt", "currency", "policy", "routes"],
  "properties": {
    "schemaVersion": { "const": "clervo.blockchain-data-supply-pricing.v1" },
    "priceVersion": { "type": "string", "pattern": "^blockchain-data-supply-[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$" },
    "effectiveAt": { "type": "string", "format": "date-time" },
    "currency": { "const": "USD" },
    "policy": {
      "type": "object",
      "required": ["customerFreeByDefault", "automaticPaidUpgradeAllowed", "providerNamesPublic", "customerWalletPayloadsInEvidenceAllowed"],
      "properties": {
        "customerFreeByDefault": { "const": false },
        "automaticPaidUpgradeAllowed": { "const": false },
        "providerNamesPublic": { "type": "boolean" },
        "customerWalletPayloadsInEvidenceAllowed": { "const": false }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["serviceId", "productId", "publicAssetId", "billingUnit", "customerPriceMicrousd", "shadowSupplierPriceMicrousd", "supplierPriceBasis", "dailyDevelopmentAllowance", "rateLimitRequestsPerSecond", "qualityGrade", "technicalQualificationStatus", "listingStatus", "termsStatus", "fallbackStatus"],
        "properties": {
          "serviceId": { "type": "string", "pattern": "^supply\\.[a-z0-9_]+$" },
          "productId": { "type": "string", "pattern": "^crypto\\.[a-z0-9_.-]+$" },
          "publicAssetId": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$" },
          "billingUnit": { "const": "request" },
          "customerPriceMicrousd": { "type": "integer", "minimum": 1 },
          "shadowSupplierPriceMicrousd": { "type": ["integer", "null"], "minimum": 0 },
          "supplierPriceBasis": { "enum": ["published_paid_tier", "recurring_free_tier", "unknown"] },
          "dailyDevelopmentAllowance": { "type": ["integer", "null"], "minimum": 0 },
          "rateLimitRequestsPerSecond": { "type": ["integer", "null"], "minimum": 1 },
          "qualityGrade": { "enum": ["best", "good", "poor", "rejected", "not_run"] },
          "technicalQualificationStatus": { "enum": ["passed", "failed", "not_run"] },
          "listingStatus": { "enum": ["qualified_not_integrated", "adapter_ready_owner_credential", "priced_terms_blocked", "sellable_preview", "blocked"] },
          "termsStatus": { "enum": ["approved", "restricted", "blocked", "unreviewed"] },
          "fallbackStatus": { "enum": ["independent_fallback_missing", "independent_fallback_ready"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
