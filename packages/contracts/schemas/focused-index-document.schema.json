{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.clervo.dev/2026-07-29.1/focused-index-document.schema.json",
  "title": "Clervo focused-index document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "schemaVersion", "routeId", "documentId", "providerId", "title", "content", "contentFingerprint", "fetchedAt", "staleAt", "expiresAt", "recrawlAt", "provenance"],
  "properties": {
    "contractVersion": { "const": "2026-07-29.1" },
    "schemaVersion": { "const": "clervo.focused-index.document.v1" },
    "routeId": { "const": "clervo.focused-index.v1" },
    "documentId": { "type": "string", "pattern": "^fid_[a-f0-9]{64}$" },
    "providerId": { "const": "provider_meilisearch_1_51_0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 512 },
    "content": { "type": "string", "minLength": 1, "maxLength": 500000 },
    "contentFingerprint": { "$ref": "#/$defs/hash" },
    "fetchedAt": { "type": "string", "format": "date-time" },
    "staleAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "recrawlAt": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceUrl", "canonicalUrl", "domain", "fetchedAt", "contentHash", "mime", "language", "freshnessState"],
      "properties": {
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "canonicalUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "domain": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$" },
        "fetchedAt": { "type": "string", "format": "date-time" },
        "contentHash": { "$ref": "#/$defs/hash" },
        "mime": { "enum": ["text/html", "text/plain", "application/xhtml+xml"] },
        "language": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})?$" },
        "freshnessState": { "enum": ["fresh", "stale", "expired"] }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
