{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/live-intelligence-alert-policy.schema.json",
  "title": "Clervo Live Intelligence change-alert policy",
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "eventType": { "enum": ["added", "modified", "removed"] },
    "changedField": { "enum": ["presence", "title", "snippet", "evidenceText", "publishedAt", "sourceId", "authorityScore", "relevanceScore", "rank"] }
  },
  "type": "object",
  "required": ["contractVersion", "schemaVersion", "policyId", "monitorId", "eventTypes", "changedFields", "minimumMatchingEvents", "severity", "deliveryMode", "createdAt", "policyHash"],
  "properties": {
    "contractVersion": { "const": "2026-07-29.1" },
    "schemaVersion": { "const": "live-intelligence-alert-policy.v1" },
    "policyId": { "type": "string", "pattern": "^alpol_[A-Za-z0-9]{20,64}$" },
    "monitorId": { "type": "string", "pattern": "^mon_[A-Za-z0-9]{20,64}$" },
    "eventTypes": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/eventType" } },
    "changedFields": { "type": "array", "minItems": 1, "maxItems": 9, "uniqueItems": true, "items": { "$ref": "#/$defs/changedField" } },
    "minimumMatchingEvents": { "type": "integer", "minimum": 1, "maximum": 100 },
    "severity": { "enum": ["info", "warning", "critical"] },
    "deliveryMode": { "const": "record_only" },
    "createdAt": { "type": "string", "format": "date-time" },
    "policyHash": { "$ref": "#/$defs/hash" }
  },
  "additionalProperties": false
}
