{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/ai-execution-result.schema.json",
  "title": "Clervo verified AI execution result",
  "$defs": {
    "usage": {
      "type": "object",
      "required": ["inputTokens", "cachedInputTokens", "outputTokens", "reasoningTokens", "images", "audioCharacters"],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "cachedInputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "reasoningTokens": { "type": "integer", "minimum": 0 },
        "images": { "type": "integer", "minimum": 0 },
        "audioCharacters": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "amount": {
      "type": "object",
      "required": ["asset", "amountAtomic", "decimals"],
      "properties": {
        "asset": { "const": "USD" },
        "amountAtomic": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,77})$" },
        "decimals": { "const": 6 }
      },
      "additionalProperties": false
    },
    "chatOutput": {
      "type": "object",
      "required": ["kind", "content", "finishReason"],
      "properties": {
        "kind": { "const": "chat" },
        "content": { "type": "string", "minLength": 1, "maxLength": 1000000 },
        "finishReason": { "enum": ["stop", "length", "tool_calls"] },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["text", "citationIds"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 100000 },
              "citationIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^cite_[A-Za-z0-9]{20,64}$" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "embeddingOutput": {
      "type": "object",
      "required": ["kind", "vectors"],
      "properties": {
        "kind": { "const": "embedding" },
        "vectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["index", "embedding"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "embedding": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "type": "number" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "imageOutput": {
      "type": "object",
      "required": ["kind", "artifacts"],
      "properties": {
        "kind": { "const": "image" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["artifactUri", "sha256", "mimeType", "width", "height"],
            "properties": {
              "artifactUri": { "type": "string", "pattern": "^artifact://[A-Za-z0-9._/-]{8,256}$" },
              "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp"] },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "speechOutput": {
      "type": "object",
      "required": ["kind", "artifact"],
      "properties": {
        "kind": { "const": "speech" },
        "artifact": {
          "type": "object",
          "required": ["artifactUri", "sha256", "mimeType", "bytes"],
          "properties": {
            "artifactUri": { "type": "string", "pattern": "^artifact://[A-Za-z0-9._/-]{8,256}$" },
            "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "mimeType": { "enum": ["audio/mpeg", "audio/ogg", "audio/aac", "audio/flac", "audio/wav", "audio/pcm"] },
            "bytes": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["contractVersion", "schemaVersion", "operationId", "productId", "requestedModel", "routeDecisionHash", "routeId", "providerId", "exactModelId", "completedAt", "usage", "supplierCost", "output", "resultHash"],
  "properties": {
    "contractVersion": { "const": "2026-07-29.1" },
    "schemaVersion": { "const": "ai-execution-result.v1" },
    "operationId": { "type": "string", "pattern": "^op_[A-Za-z0-9]{20,64}$" },
    "productId": { "enum": ["ai.chat", "ai.embed", "ai.image", "ai.speech"] },
    "requestedModel": { "type": "string", "minLength": 1, "maxLength": 160 },
    "routeDecisionHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "routeId": { "type": "string", "pattern": "^ai\\.route\\.[a-z0-9_]+$" },
    "providerId": { "type": "string", "pattern": "^provider\\.[a-z0-9_]+$" },
    "exactModelId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "completedAt": { "type": "string", "format": "date-time" },
    "usage": { "$ref": "#/$defs/usage" },
    "supplierCost": { "$ref": "#/$defs/amount" },
    "output": { "oneOf": [{ "$ref": "#/$defs/chatOutput" }, { "$ref": "#/$defs/embeddingOutput" }, { "$ref": "#/$defs/imageOutput" }, { "$ref": "#/$defs/speechOutput" }] },
    "resultHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
