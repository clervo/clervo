{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/schema-visibility.schema.json",
  "title": "Clervo schema visibility manifest",
  "type": "object",
  "required": ["policyVersion", "defaultVisibility", "schemas"],
  "properties": {
    "policyVersion": { "const": "2026-08-01.1" },
    "defaultVisibility": { "const": "deny" },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "schemaId", "visibility", "reason"],
        "properties": {
          "file": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.schema\\.json$" },
          "schemaId": { "type": "string", "format": "uri", "pattern": "^https://(?:api\\.clervo\\.dev/schemas|schemas\\.clervo\\.dev)/" },
          "visibility": { "enum": ["public_wire", "internal_control", "sealed_evidence"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
