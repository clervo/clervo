{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/sandbox-runtime-policy.schema.json",
  "type": "object",
  "required": ["schemaVersion", "lifecycle", "runtime", "identity", "filesystem", "network", "limits", "forbidden", "qualification"],
  "properties": {
    "schemaVersion": { "const": "clervo.sandbox-runtime-policy.v1" },
    "lifecycle": { "const": "unavailable" },
    "runtime": { "type": "object", "required": ["class", "runtimeClassName", "orchestrator", "resourceModel", "dataPlane", "plainContainerAllowed", "dedicatedExecutionNodes", "controlPlaneSeparated"], "properties": { "class": { "const": "gvisor" }, "runtimeClassName": { "const": "gvisor" }, "orchestrator": { "const": "agent-sandbox" }, "resourceModel": { "const": "template-claim" }, "dataPlane": { "const": "gke-dataplane-v2" }, "plainContainerAllowed": { "const": false }, "dedicatedExecutionNodes": { "const": true }, "controlPlaneSeparated": { "const": true } }, "additionalProperties": false },
    "identity": { "type": "object", "required": ["runAsNonRoot", "allowPrivilegeEscalation", "capabilitiesDropped", "serviceAccountTokenMounted", "executionNodeSecrets"], "properties": { "runAsNonRoot": { "const": true }, "allowPrivilegeEscalation": { "const": false }, "capabilitiesDropped": { "const": "ALL" }, "serviceAccountTokenMounted": { "const": false }, "executionNodeSecrets": { "const": false } }, "additionalProperties": false },
    "filesystem": { "type": "object", "required": ["imageDigestRequired", "readOnlyRootFilesystem", "ephemeralWritesOnly", "hostPathsAllowed"], "properties": { "imageDigestRequired": { "const": true }, "readOnlyRootFilesystem": { "const": true }, "ephemeralWritesOnly": { "const": true }, "hostPathsAllowed": { "const": false } }, "additionalProperties": false },
    "network": { "type": "object", "required": ["management", "defaultEgress", "defaultIngress", "metadataAllowed", "internalNetworksAllowed", "modelGatewayAllowed"], "properties": { "management": { "const": "Managed" }, "defaultEgress": { "const": "deny" }, "defaultIngress": { "const": "deny" }, "metadataAllowed": { "const": false }, "internalNetworksAllowed": { "const": false }, "modelGatewayAllowed": { "const": false } }, "additionalProperties": false },
    "limits": { "type": "object", "required": ["cpuMillis", "memoryBytes", "processes", "diskBytes", "outputBytes", "artifactBytes", "wallTimeMs", "maximumChargeMicrousd"], "properties": { "cpuMillis": { "type": "integer", "minimum": 1, "maximum": 300000 }, "memoryBytes": { "type": "integer", "minimum": 16777216, "maximum": 8589934592 }, "processes": { "type": "integer", "minimum": 1, "maximum": 256 }, "diskBytes": { "type": "integer", "minimum": 1048576, "maximum": 10737418240 }, "outputBytes": { "type": "integer", "minimum": 1, "maximum": 10485760 }, "artifactBytes": { "type": "integer", "minimum": 1, "maximum": 104857600 }, "wallTimeMs": { "type": "integer", "minimum": 100, "maximum": 300000 }, "maximumChargeMicrousd": { "type": "integer", "minimum": 1, "maximum": 1000000 } }, "additionalProperties": false },
    "forbidden": { "type": "array", "minItems": 12, "uniqueItems": true, "items": { "enum": ["hostNetwork", "hostPID", "hostIPC", "privileged", "hostPath", "hostPort", "customSysctls", "addedCapabilities", "projectedCredentials", "hostSockets", "devices", "commerceSecrets", "providerSecrets", "walletMaterial"] } },
    "qualification": { "type": "object", "required": ["runtimeAttested", "redTeamStatus", "cleanupStatus", "costStatus"], "properties": { "runtimeAttested": { "const": true }, "redTeamStatus": { "const": "passed" }, "cleanupStatus": { "const": "passed" }, "costStatus": { "const": "bounded" } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
