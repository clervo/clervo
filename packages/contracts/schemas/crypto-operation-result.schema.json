{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/crypto-operation-result.schema.json",
  "$defs": {
    "json": { "anyOf": [
      { "type": "null" }, { "type": "boolean" }, { "type": "number" }, { "type": "string", "maxLength": 65536 },
      { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/json" } },
      { "type": "object", "maxProperties": 1000, "additionalProperties": { "$ref": "#/$defs/json" } }
    ] },
    "chainId": { "enum": ["eip155:1", "eip155:8453"] },
    "charge": { "type": "object", "required": ["asset", "amountAtomic", "decimals"], "properties": { "asset": { "const": "USD" }, "amountAtomic": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,6})$" }, "decimals": { "const": 6 } }, "additionalProperties": false }
  },
  "type": "object",
  "required": ["contractVersion", "schemaVersion", "operationId", "productId", "completedAt", "meteredCharge", "output", "resultHash"],
  "properties": {
    "contractVersion": { "const": "2026-07-29.1" },
    "schemaVersion": { "const": "crypto-operation-result.v1" },
    "operationId": { "type": "string", "pattern": "^op_[A-Za-z0-9]{20,64}$" },
    "productId": { "enum": ["crypto.wallet.balances", "crypto.wallet.tokens", "crypto.wallet.transactions", "crypto.wallet.report"] },
    "completedAt": { "type": "string", "format": "date-time" },
    "meteredCharge": { "$ref": "#/$defs/charge" },
    "output": {
      "type": "object",
      "required": ["kind", "state", "requestedChains", "servedChains", "observedAt", "derivedAt", "freshness", "coverage", "evidence", "evidenceRefs", "provenance", "data"],
      "properties": {
        "kind": { "enum": ["balances", "tokens", "transactions", "report"] },
        "state": { "enum": ["available", "degraded"] },
        "requestedChains": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/chainId" } },
        "servedChains": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/chainId" } },
        "observedAt": { "type": ["string", "null"], "format": "date-time" },
        "derivedAt": { "type": "string", "format": "date-time" },
        "freshness": { "$ref": "#/$defs/json" },
        "coverage": { "$ref": "#/$defs/json" },
        "evidence": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/json" } },
        "evidenceRefs": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "pattern": "^evidence_[a-f0-9]{32}$" } },
        "provenance": { "$ref": "#/$defs/json" },
        "data": { "$ref": "#/$defs/json" }
      },
      "additionalProperties": false
    },
    "resultHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "allOf": [
    { "if": { "properties": { "productId": { "const": "crypto.wallet.balances" } }, "required": ["productId"] }, "then": { "properties": { "output": { "type": "object", "properties": { "kind": { "const": "balances" } } } } } },
    { "if": { "properties": { "productId": { "const": "crypto.wallet.tokens" } }, "required": ["productId"] }, "then": { "properties": { "output": { "type": "object", "properties": { "kind": { "const": "tokens" } } } } } },
    { "if": { "properties": { "productId": { "const": "crypto.wallet.transactions" } }, "required": ["productId"] }, "then": { "properties": { "output": { "type": "object", "properties": { "kind": { "const": "transactions" } } } } } },
    { "if": { "properties": { "productId": { "const": "crypto.wallet.report" } }, "required": ["productId"] }, "then": { "properties": { "output": { "type": "object", "properties": { "kind": { "const": "report" } } } } } }
  ],
  "additionalProperties": false
}
