{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/release-candidate-freeze.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "releaseCandidateId",
    "frozenAt",
    "state",
    "noPublicDistribution",
    "baseRegistry",
    "schemaVisibility",
    "privateWorkflowCatalog",
    "coreQualifications",
    "operationSet",
    "lifecycleProjection",
    "prices",
    "schemas",
    "examples",
    "interfaceHash"
  ],
  "properties": {
    "schemaVersion": { "const": "clervo.release-candidate-freeze.v1" },
    "releaseCandidateId": { "type": "string", "pattern": "^clervo-private-core-[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$" },
    "frozenAt": { "type": "string", "format": "date-time" },
    "state": { "const": "private_core_frozen" },
    "noPublicDistribution": { "const": true },
    "baseRegistry": { "$ref": "#/$defs/versionedSource" },
    "schemaVisibility": { "$ref": "#/$defs/versionedSource" },
    "privateWorkflowCatalog": { "$ref": "#/$defs/source" },
    "coreQualifications": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["pillar", "privateCoreQualified", "publicLifecycle"],
        "properties": {
          "pillar": { "enum": ["search", "ai", "sandbox", "rpc", "prediction", "crypto"] },
          "privateCoreQualified": { "const": true },
          "publicLifecycle": { "enum": ["preview", "unavailable"] }
        },
        "additionalProperties": false
      }
    },
    "operationSet": {
      "type": "object",
      "required": ["publicOperationIds", "internalOperationIds", "total"],
      "properties": {
        "publicOperationIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._][a-z0-9]+)+$" }
        },
        "internalOperationIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._][a-z0-9]+)+$" }
        },
        "total": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "lifecycleProjection": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["pillarId", "lifecycle"],
        "properties": {
          "pillarId": { "enum": ["search", "ai", "sandbox", "rpc", "prediction", "crypto_intelligence"] },
          "lifecycle": { "enum": ["preview", "unavailable"] }
        },
        "additionalProperties": false
      }
    },
    "prices": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/source" }
    },
    "schemas": { "$ref": "#/$defs/aggregate" },
    "examples": { "$ref": "#/$defs/aggregate" },
    "interfaceHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source": {
      "type": "object",
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "versionedSource": {
      "type": "object",
      "required": ["file", "version", "sha256"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "aggregate": {
      "type": "object",
      "required": ["directory", "count", "aggregateHash"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "aggregateHash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
