{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/adapter-manifest.schema.json",
  "title": "Clervo adapter manifest",
  "type": "object",
  "required": ["contractVersion", "adapterId", "adapterVersion", "providerId", "failureDomain", "productIds", "requiredSecretNames", "dataResidency"],
  "properties": {
    "contractVersion": { "const": "2026-07-29.1" },
    "adapterId": { "type": "string", "pattern": "^adapter_[a-z0-9][a-z0-9._-]{2,63}$" },
    "adapterVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "providerId": { "type": "string", "pattern": "^provider_[a-z0-9][a-z0-9._-]{2,63}$" },
    "failureDomain": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
    "productIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$" } },
    "requiredSecretNames": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" } },
    "dataResidency": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$" } }
  },
  "additionalProperties": false
}