{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/prediction-product-pricing.schema.json",
  "type": "object",
  "required": ["schemaVersion", "priceVersion", "effectiveAt", "currency", "lifecycle", "providerNamesPublic", "minimumBillableMicrousd", "subsidy", "products"],
  "properties": {
    "schemaVersion": { "const": "clervo.prediction-product-pricing.v1" },
    "priceVersion": { "type": "string", "pattern": "^prediction-product-[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$" },
    "effectiveAt": { "type": "string", "format": "date-time" },
    "currency": { "const": "USD" },
    "lifecycle": { "enum": ["unavailable", "live"] },
    "providerNamesPublic": { "type": "boolean" },
    "minimumBillableMicrousd": { "type": "integer", "minimum": 1000, "maximum": 1000000 },
    "costBasis": {
      "type": "object",
      "required": ["observedAt", "zeroCostDataSupply", "facilitatorFreeSettlementsPerMonth", "facilitatorOverageMicrousdPerSettlement", "postFreeTierCostIncluded", "evidenceUrls"],
      "properties": {
        "observedAt": { "type": "string", "format": "date-time" },
        "zeroCostDataSupply": { "const": true },
        "facilitatorFreeSettlementsPerMonth": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "facilitatorOverageMicrousdPerSettlement": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "postFreeTierCostIncluded": { "const": true },
        "evidenceUrls": { "type": "array", "minItems": 3, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } }
      },
      "additionalProperties": false
    },
    "subsidy": { "type": "object", "required": ["enabled", "budgetMicrousd", "ownerApprovalRequired"], "properties": { "enabled": { "const": false }, "budgetMicrousd": { "const": 0 }, "ownerApprovalRequired": { "const": true } }, "additionalProperties": false },
    "products": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["productId", "billingUnit", "customerPriceMicrousd", "supplierCostMicrousd", "infrastructureCostAllowanceMicrousd", "listingStatus", "maximumItems", "maximumResponseBytes"],
        "properties": {
          "productId": { "enum": ["prediction.markets", "prediction.market", "prediction.compare", "prediction.history", "prediction.signal"] },
          "billingUnit": { "const": "request" },
          "customerPriceMicrousd": { "type": "integer", "minimum": 1000, "maximum": 1000000 },
          "supplierCostMicrousd": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "infrastructureCostAllowanceMicrousd": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "listingStatus": { "enum": ["commercial_permission_blocked", "sellable"] },
          "maximumItems": { "type": "integer", "minimum": 1, "maximum": 201 },
          "maximumResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 10485760 }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [{ "if": { "properties": { "lifecycle": { "const": "live" } }, "required": ["lifecycle"] }, "then": { "properties": { "costBasis": {} }, "required": ["costBasis"] } }],
  "additionalProperties": false
}
