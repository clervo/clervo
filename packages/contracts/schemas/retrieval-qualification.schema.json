{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.clervo.dev/schemas/2026-07-29.1/retrieval-qualification.schema.json",
  "title": "Clervo retrieval qualification snapshot",
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["url", "observedAt", "sha256"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "observedAt": { "type": "string", "format": "date-time" },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["name", "status", "evidence"],
      "properties": {
        "name": { "enum": ["terms", "authentication", "quota", "response_contract", "content_use", "failure_isolation"] },
        "status": { "enum": ["passed", "failed", "not_run"] },
        "evidence": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/evidence" } },
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" }
      },
      "additionalProperties": false
    },
    "path": {
      "type": "object",
      "required": ["pathId", "providerId", "failureDomain", "role", "mechanism", "selected", "checkedAt", "expiresAt", "termsStatus", "allowedContentUse", "restrictionsAcknowledged", "checks", "routeEligible", "failureCodes"],
      "properties": {
        "pathId": { "type": "string", "pattern": "^retrieval_[a-z0-9][a-z0-9._-]{2,63}$" },
        "providerId": { "type": "string", "pattern": "^provider_[a-z0-9][a-z0-9._-]{2,63}$" },
        "failureDomain": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
        "role": { "enum": ["primary", "fallback"] },
        "mechanism": { "enum": ["provider_api", "public_archive"] },
        "selected": { "type": "boolean" },
        "checkedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "termsStatus": { "enum": ["approved", "restricted", "blocked", "unreviewed"] },
        "allowedContentUse": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["search_metadata", "transient_extraction", "retained_evidence", "archive_replay"] }
        },
        "restrictionsAcknowledged": { "type": "boolean" },
        "checks": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/check" } },
        "routeEligible": { "type": "boolean" },
        "failureCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,95}$" } }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["contractVersion", "qualificationId", "evaluatedAt", "paths", "independentFailureDomains", "twoPathGatePassed"],
  "properties": {
    "contractVersion": { "const": "2026-07-29.1" },
    "qualificationId": { "type": "string", "pattern": "^rqual_[A-Za-z0-9]{20,64}$" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "paths": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/path" } },
    "independentFailureDomains": { "type": "boolean" },
    "twoPathGatePassed": { "type": "boolean" }
  },
  "additionalProperties": false
}