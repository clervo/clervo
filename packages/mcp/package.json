{
  "name": "@clervo/mcp",
  "version": "0.5.2",
  "mcpName": "io.github.clervo/connect",
  "description": "MCP server for Clervo AI and agent tools with pay-per-use x402 payment controls.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "clervo",
    "ai-agents",
    "x402",
    "mcp",
    "model-context-protocol",
    "search"
  ],
  "homepage": "https://clervo.dev/docs/mcp",
  "bugs": {
    "url": "https://github.com/clervo/clervo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clervo/clervo.git",
    "directory": "packages/mcp"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "clervo-mcp": "./dist/run.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "npm run build --workspace @clervo/sdk && tsc --project tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clervo/sdk": "0.5.2",
    "@clervo/router": "0.3.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
